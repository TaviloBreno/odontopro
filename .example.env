# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
AUTH_SECRET=""

# Local-only demo login. Never enable test login in production.
TEST_LOGIN_ENABLED=true
TEST_LOGIN_EMAIL=demo@odontopro.local
TEST_LOGIN_PASSWORD=OdontoPro123!
TEST_EMPLOYEE_EMAIL=funcionario@odontopro.local
TEST_EMPLOYEE_PASSWORD=OdontoFuncionario123!
TEST_CLIENT_EMAIL=cliente@odontopro.local
TEST_CLIENT_PASSWORD=OdontoCliente123!
TEST_PLATFORM_ADMIN_EMAIL=plataforma@odontopro.local
TEST_PLATFORM_ADMIN_PASSWORD=OdontoPlataforma123!

DATABASE_URL="postgresql://odontopro:odontopro-local-dev@localhost:5432/odontopro?schema=public"

# Local PostgreSQL container defaults used by compose.yaml (development only)
POSTGRES_USER=odontopro
POSTGRES_PASSWORD=odontopro-local-dev
POSTGRES_DB=odontopro
POSTGRES_PORT=5432

# Login Github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Login google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


NEXT_PUBLIC_URL=http://localhost:3000

# Stripe Gateway
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=

STRIPE_SECRET_WEBHOOK_KEY=

STRIPE_PLAN_BASIC=
STRIPE_PLAN_PROFISSIONAL=
STRIPE_PLAN_PREMIUM=

STRIPE_SUCCESS_URL=http://localhost:3000/dashboard/plans
STRIPE_CANCEL_URL=http://localhost:3000/dashboard/plans

